{
  "name": "x-article-factory",
  "version": "0.1.0",
  "description": "Quality gates for long-form X (Twitter) Articles: structure checks, AI-tell detection, publish-risk scan, and local figure generation.",
  "type": "module",
  "bin": {
    "xaf": "./bin/xaf.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node bin/xaf.mjs check examples/sample.md",
    "figures": "node bin/xaf.mjs figures examples/sample.md --out out"
  },
  "dependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "x",
    "twitter",
    "articles",
    "lint",
    "markdown",
    "quality",
    "figures",
    "seo"
  ],
  "files": [
    "bin",
    "lib",
    "docs/RULES.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avabb0916/x-article-factory.git"
  },
  "homepage": "https://github.com/avabb0916/x-article-factory#readme",
  "bugs": {
    "url": "https://github.com/avabb0916/x-article-factory/issues"
  },
  "author": "avabb0916"
}